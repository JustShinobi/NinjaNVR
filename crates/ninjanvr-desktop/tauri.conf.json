{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NinjaNVR Console",
  "version": "0.9.0",
  "identifier": "io.github.justshinobi.ninjanvr",
  "build": {
    "beforeDevCommand": "bun run --cwd ../../web-v2 dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run --cwd ../../web-v2 build",
    "frontendDist": "../../web-v2/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NinjaNVR Console v2",
        "width": 1600,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#090A0D"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
