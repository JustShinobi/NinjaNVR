#!/usr/bin/env python3
"""
Enforces SemVer and release manifest invariants across the workspace:
1. Cargo.toml ([workspace.package] version), web-v2/package.json (version),
   and all ninjanvr* entries in Cargo.lock must use valid SemVer (X.Y.Z or X.Y.Z-rc.N)
   and be 100% synchronized.
2. Top entry in CHANGELOG.md must be a valid [X.Y.Z] - YYYY-MM-DD header.
3. When --staged is passed (during pre-commit), blocks manual edits to workspace
   version fields or CHANGELOG.md unless NINJANVR_RELEASE_BOT=1 or
   NINJANVR_ALLOW_RELEASE_EDIT=1 is set (versions and CHANGELOG.md are managed
   automatically by ./scripts/ci/cut-release).
"""

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

SEMVER_RE = re.compile(r"^(\d+)\.(\d+)\.(\d+)(?:-rc\.(\d+))?$")
CARGO_WORKSPACE_VER_RE = re.compile(
    r'(?ms)^\[workspace\.package\]\s+.*?^version\s*=\s*"([^"]+)"'
)
CARGO_LOCK_PKG_RE = re.compile(
    r'name\s*=\s*"(ninjanvr(?:-[a-z0-9_]+)?)"\nversion\s*=\s*"([^"]+)"'
)
CHANGELOG_HEADER_RE = re.compile(r"(?m)^## \[(\d+\.\d+\.\d+)\] - (\d{4}-\d{2}-\d{2})$")


def fail(msg: str) -> int:
    print(f"ERROR [check-semver]: {msg}", file=sys.stderr)
    return 1


def check_staged_release_edits() -> int:
    if (
        os.environ.get("NINJANVR_RELEASE_BOT") == "1"
        or os.environ.get("NINJANVR_ALLOW_RELEASE_EDIT") == "1"
    ):
        return 0

    res = subprocess.run(
        ["git", "diff", "--cached", "--name-only"],
        capture_output=True,
        text=True,
        check=True,
    )
    staged_files = set(res.stdout.splitlines())

    if "CHANGELOG.md" in staged_files:
        return fail(
            "Manual edits to CHANGELOG.md are blocked. "
            "CHANGELOG.md is generated automatically by ./scripts/ci/cut-release when promoting dev -> main. "
            "(Set NINJANVR_ALLOW_RELEASE_EDIT=1 only if fixing a historical typo.)"
        )

    if "Cargo.toml" in staged_files:
        diff = subprocess.run(
            ["git", "diff", "--cached", "-U0", "--", "Cargo.toml"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout
        for line in diff.splitlines():
            if line.startswith(("+", "-")) and not line.startswith(("+++", "---")):
                if re.match(r'^[+-]version\s*=\s*"', line):
                    return fail(
                        "Manual version bump in Cargo.toml is blocked. "
                        "SemVer versions are calculated and bumped automatically by ./scripts/ci/cut-release."
                    )

    if "web-v2/package.json" in staged_files:
        diff = subprocess.run(
            ["git", "diff", "--cached", "-U0", "--", "web-v2/package.json"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout
        for line in diff.splitlines():
            if line.startswith(("+", "-")) and not line.startswith(("+++", "---")):
                if re.search(r'"version"\s*:', line):
                    return fail(
                        "Manual version bump in web-v2/package.json is blocked. "
                        "SemVer versions are calculated and bumped automatically by ./scripts/ci/cut-release."
                    )

    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Validate workspace SemVer invariants.")
    parser.add_argument(
        "--staged",
        action="store_true",
        help="Also verify that staged changes do not manually mutate release versions or CHANGELOG.md.",
    )
    args = parser.parse_args()

    repo_root = Path(__file__).resolve().parents[2]
    os.chdir(repo_root)

    cargo_toml = Path("Cargo.toml").read_text(encoding="utf-8")
    m_cargo = CARGO_WORKSPACE_VER_RE.search(cargo_toml)
    if not m_cargo:
        return fail("Could not locate [workspace.package] version in Cargo.toml.")
    cargo_version = m_cargo.group(1)

    if not SEMVER_RE.match(cargo_version):
        return fail(
            f"Cargo.toml workspace version '{cargo_version}' is not valid SemVer (expected X.Y.Z or X.Y.Z-rc.N)."
        )

    pkg_json = json.loads(Path("web-v2/package.json").read_text(encoding="utf-8"))
    web_version = pkg_json.get("version", "")
    if not SEMVER_RE.match(web_version):
        return fail(
            f"web-v2/package.json version '{web_version}' is not valid SemVer (expected X.Y.Z or X.Y.Z-rc.N)."
        )

    if cargo_version != web_version:
        return fail(
            f"Version mismatch between Cargo.toml ({cargo_version}) and web-v2/package.json ({web_version})."
        )

    cargo_lock_path = Path("Cargo.lock")
    if cargo_lock_path.exists():
        cargo_lock = cargo_lock_path.read_text(encoding="utf-8")
        lock_matches = CARGO_LOCK_PKG_RE.findall(cargo_lock)
        if not lock_matches:
            return fail("No ninjanvr workspace crates found in Cargo.lock.")
        for crate_name, lock_ver in lock_matches:
            if lock_ver != cargo_version:
                return fail(
                    f"Version mismatch in Cargo.lock for {crate_name}: found {lock_ver}, expected {cargo_version}."
                )

    changelog_path = Path("CHANGELOG.md")
    if not changelog_path.exists():
        return fail("CHANGELOG.md is missing.")
    changelog = changelog_path.read_text(encoding="utf-8")
    m_cl = CHANGELOG_HEADER_RE.search(changelog)
    if not m_cl:
        return fail(
            "CHANGELOG.md does not contain a valid '## [X.Y.Z] - YYYY-MM-DD' release section header."
        )

    if args.staged:
        rc = check_staged_release_edits()
        if rc != 0:
            return rc

    print(f"==> SemVer manifest check passed (workspace version: {cargo_version}).")
    return 0


if __name__ == "__main__":
    sys.exit(main())
